#####
# Configuration file for the Gateway Device App (GDA)
#

#
# Cloud client selector (USED BY CloudClientFactory)
#
[Cloud.GatewayService]
cloudServiceName = Ubidots


#
# Ubidots Cloud configuration
#
[Cloud.GatewayService.Ubidots]
credFile       = /home/ernest/piot/gda-java-components/cred/UbidotsCloudCred.props
certFile       = /home/ernest/piot/gda-java-components/cert/UbidotsCloudCert.pem
cloudServiceName = Ubidots
host           = industrial.api.ubidots.com
port           = 1883
securePort     = 8883
defaultQoS     = 0
keepAlive      = 30
useAsyncClient = True
enableAuth     = True
enableCrypt    = True
baseUrl        = https://things.ubidots.com/api/v1.6/
baseTopic      = /v1.6/devices/
clientID       = gda-device


#
# AWS Cloud configuration (placeholder – not active)
#
[Cloud.GatewayService.AWS]
credFile         = ./cred/AwsCloudCred.props
certFile         = ./cert/AwsCloudCert.pem
privateKeyFile   = ./cert/AwsCloudKey.key
cloudServiceName = AWS
host             = example.amazonaws.com
securePort       = 8883
defaultQoS       = 1
keepAlive        = 60
enableAuth       = True
enableCrypt      = True
baseUrl          =
baseTopic        =


#
# SMTP client configuration information
#
[Smtp.GatewayService]
credFile       = ./cred/PiotSmtpCred.props
host           = localhost
port           = 25
securePort     = 587
enableAuth     = True
enableCrypt    = True


#
# MQTT client configuration information (LOCAL broker)
#
[Mqtt.GatewayService]
credFile       = ./cred/PiotMqttCred.props
certFile       = /home/ernest/piot/mosq_certs/ca.crt
host           = localhost
port           = 1883
securePort     = 8883
defaultQoS     = 0
keepAlive      = 60
enableAuth     = True
enableCrypt    = True
useAsyncClient = True


#
# CoAP client and server configuration information
#
[Coap.GatewayService]
credFile       = ./cred/PiotCoapCred.props
certFile       = ./cert/PiotCoapLocalCertFile.pem
host           = localhost
port           = 5683
securePort     = 5684
enableAuth     = False
enableCrypt    = False
enableConfirmedMsgs = True


#
# GDA specific configuration information
#
[GatewayDevice]
deviceLocationID        = gatewaydevice001
enableLogging           = True
pollCycleSecs           = 60
enableMqttClient        = True
enableCoapServer        = True
enableCoapClient        = False
enableCloudClient       = True
enableSmtpClient        = False
enablePersistenceClient = False
enableSystemPerformance = True
testGdaDataPath         = /tmp/gda-data
testCdaDataPath         = /tmp/cda-data
testEmptyApp            = False
handleHumidityChangeOnDevice = true


# Sensor thresholds
temperatureMinThreshold         = 0
temperatureMaxThreshold         = 50
humidityMinThreshold            = 20
humidityMaxThreshold            = 80
humidityMaxTimePastThreshold    = 10
nominalHumiditySetting          = 40.0
triggerHumidifierFloor          = 30.0
triggerHumidifierCeiling        = 50.0
pressureMinThreshold            = 900
pressureMaxThreshold            = 1100


# Optional timing/configuration
coapServerPort                  = 5683
coapSecurePort                  = 5684
mqttDefaultQoS                  = 0
mqttKeepAlive                   = 60

